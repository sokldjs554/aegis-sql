      {
        "id": "kfb-h17",
        "difficulty": "hard",
        "question": "올해 월별 신계약 건수가 직전 달보다 늘어난 달은?",
        "template": {
          "label": "Template",
          "correct": false,
          "status": "ok",
          "sql": "SELECT\n  SUBSTRING(t1.CTRT_DT, 1, 6) AS \"월\",\n  COUNT(*) AS \"건수\"\nFROM TB_CTRT AS t1\nWHERE\n  t1.CTRT_DT BETWEEN '20260101' AND '20261231'\nGROUP BY\n  SUBSTRING(t1.CTRT_DT, 1, 6)\nORDER BY\n  SUBSTRING(t1.CTRT_DT, 1, 6) ASC",
          "latency_ms": 6.3,
          "cost_usd": 0.0,
          "outcome_ko": "EX FAIL",
          "error": "result mismatch (pred 8행 × 2열 vs gold 4행 × 3열)"
        },
        "llm": {
          "label": "Claude 단독",
          "correct": true,
          "status": "ok",
          "sql": "WITH monthly_new AS (\n    SELECT\n        substr(c.CTRT_DT, 1, 6) AS YM,\n        COUNT(*) AS NEW_CTRT_CNT\n    FROM TB_CTRT c\n    WHERE substr(c.CTRT_DT, 1, 4) = '2026'\n    GROUP BY substr(c.CTRT_DT, 1, 6)\n),\nmonthly_with_prev AS (\n    SELECT\n        m.YM,\n        m.NEW_CTRT_CNT,\n        LAG(m.NEW_CTRT_CNT) OVER (ORDER BY m.YM) AS PREV_CNT\n    FROM monthly_new m\n)\nSELECT\n    mp.YM,\n    mp.NEW_CTRT_CNT,\n    mp.PREV_CNT\nFROM monthly_with_prev mp\nWHERE mp.PREV_CNT IS NOT NULL\n  AND mp.NEW_CTRT_CNT > mp.PREV_CNT\nORDER BY mp.YM",
          "latency_ms": 9715.5,
          "cost_usd": 0.018651,
          "outcome_ko": "EX PASS",
          "error": ""
        },
        "gold": {
          "sql": "WITH m AS (SELECT substr(CTRT_DT,1,6) AS ym, COUNT(*) AS cnt FROM TB_CTRT WHERE substr(CTRT_DT,1,4) = '2026' GROUP BY substr(CTRT_DT,1,6)) SELECT a.ym, a.cnt, b.cnt AS prev_cnt FROM m a JOIN m b ON CAST(b.ym AS INTEGER) = CAST(a.ym AS INTEGER) - 1 WHERE a.cnt > b.cnt ORDER BY a.ym",
          "row_count": 4,
          "columns": [
