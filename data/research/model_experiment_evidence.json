        "question": "계약이 100건 이상인 지점만 보여줘",
        "template": {
          "label": "Template",
          "correct": false,
          "status": "ok",
          "sql": "SELECT\n  t1.CTRT_NO AS \"계약번호\",\n  t1.CUST_ID AS \"계약자고객ID\",\n  t1.PROD_CD AS \"상품코드\",\n  t1.AGNT_ID AS \"모집설계사ID\",\n  t1.CTRT_DT AS \"계약체결일자\",\n  t1.EXPR_DT AS \"만기일자\"\nFROM TB_CTRT AS t1\nWHERE\n  EXISTS(\n    SELECT\n      1\n    FROM TB_CLM AS x1\n    WHERE\n      x1.CTRT_NO = t1.CTRT_NO AND x1.FRAUD_SCR >= 100\n  )\nLIMIT 200",
          "latency_ms": 15.0,
          "cost_usd": 0.0,
          "outcome_ko": "EX FAIL",
          "error": "result mismatch (pred 1행 × 6열 vs gold 24행 × 2열)"
        },
        "llm": {
          "label": "Claude 단독",
          "correct": true,
          "status": "ok",
          "sql": "SELECT\n    b.BRCH_CD,\n    b.BRCH_NM,\n    COUNT(c.CTRT_NO) AS CTRT_CNT\nFROM TB_CTRT c\nJOIN TB_AGNT a ON c.AGNT_ID = a.AGNT_ID\nJOIN TB_BRCH b ON a.BRCH_CD = b.BRCH_CD\nGROUP BY b.BRCH_CD, b.BRCH_NM\nHAVING COUNT(c.CTRT_NO) >= 100\nORDER BY CTRT_CNT DESC",
          "latency_ms": 6800.7,
          "cost_usd": 0.015873,
          "outcome_ko": "EX PASS",
          "error": ""
        },
        "gold": {
          "sql": "SELECT b.BRCH_NM, COUNT(*) AS cnt FROM TB_CTRT t JOIN TB_AGNT a ON a.AGNT_ID = t.AGNT_ID JOIN TB_BRCH b ON b.BRCH_CD = a.BRCH_CD GROUP BY b.BRCH_NM HAVING COUNT(*) >= 100 ORDER BY cnt DESC",
          "row_count": 24,
          "columns": [
